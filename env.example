# Образец настроек. Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env в GitHub не попадает — он в .gitignore.

# Адрес и публичный ключ базы Supabase.
# Обе строки должны относиться к ОДНОМУ проекту: кусок адреса до .supabase.co
# совпадает с полем "ref" внутри ключа.
VITE_SUPABASE_URL=https://rmqpevnruootzvqnsagv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Секретные ключи ИИ-помощника. Задаются ТОЛЬКО в Vercel,
# в локальный .env их класть не нужно.
# CLAUDE_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
